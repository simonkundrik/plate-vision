# Datasets and model artifacts are never committed.
# Datasets are fetched by model/data/ scripts; trained models ship via GitHub Releases.
model/data/food101/
model/data/nutrition5k/
model/data/personal/
# Downloaded OOD images are not redistributed. The manifest that defines the set is
# tracked; the photos it points at stay out of a public repository.
model/data/ood/images/
*.pt
*.pth
*.ckpt
*.onnx
*.ort
*.pte
*.tflite

# Kaggle run staging (assembled by scripts/run_on_kaggle.py) and credentials
.kaggle-staging/
.kaggle/

# Training outputs
runs/
outputs/
checkpoints/
wandb/
lightning_logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
dist/
build/

# Node
node_modules/
*.tsbuildinfo
.eslintcache

# Expo
.expo/
.expo-shared/
android/
ios/
*.apk
*.aab

# Vite
web/dist/
web/.vite/

# Playwright
test-results/
playwright-report/

# Secrets and local config
.env
.env.*
!.env.example
kaggle.json

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

