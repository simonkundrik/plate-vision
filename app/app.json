{
  "expo": {
    "name": "plate-vision",
    "slug": "plate-vision",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.simonkundrik.platevision"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B0B0C"
      },
      "package": "dev.simonkundrik.platevision",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "plate-vision uses the camera to photograph your meal. The photo is analysed on this device and is not uploaded.",
          "recordAudioAndroidPermission": false
        }
      ],
      "expo-dev-client",
      "onnxruntime-react-native"
    ],
    "extra": {
      "// model": "Where the app fetches the ONNX artifact and its manifest. Both are published on GitHub Releases rather than bundled: the model is tens of megabytes and would otherwise sit in every APK and in this repository. Override for a build with EXPO_PUBLIC_MODEL_URL / EXPO_PUBLIC_BUNDLE_URL. The pinned tag is deliberate: 'latest' would change the model under a build that was tested against a different one.",
      "modelUrl": "https://github.com/simonkundrik/plate-vision/releases/download/model-v0.1.0/plate-vision-fp32.onnx",
      "bundleUrl": "https://github.com/simonkundrik/plate-vision/releases/download/model-v0.1.0/bundle.json",
      "eas": {
        "projectId": "235fada8-9258-4324-a496-1fd31bee6279"
      }
    }
  }
}
